# openssl rand -hex 32
SECRET_KEY=71d5982e92ecb843fd7327179402d6d8954160340172c960ea6b167dd6ce766e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7天

YOLO_MODEL_PATH=best.pt