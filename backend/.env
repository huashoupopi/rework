# ============================================================
# 数据库配置
# ============================================================
# DB_HOST: Docker 内自动使用 "db"，本地运行自动使用 "localhost"
# 如需覆盖，取消注释：
DB_HOST=localhost
DB_PORT=5433 # 防止新容器端口与旧容器端口冲突
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=wind_db
DB_TABLE=wind_knowledge
DB_ECHO=False #数据库打印语句

# ============================================================
# JWT 认证
