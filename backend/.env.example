# ============================================================
# 数据库配置
# ============================================================
# DB_HOST: Docker 内自动使用 "db"，本地运行自动使用 "localhost"
# 如需覆盖，取消注释：
DB_HOST=localhost
DB_PORT=5433 # 防止新容器端口与旧容器端口冲突
DB_USER=xxx
DB_PASSWORD=xxx
DB_NAME=xxx
DB_TABLE=xxx
DB_ECHO=False #数据库打印语句

# ============================================================
# JWT 认证
# ============================================================
# openssl rand -hex 32
SECRET_KEY=xxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120 # access token 约 2 小时；本轮不做 refresh
ALLOWED_ORIGINS=["http://localhost:5173"]

YOLO_MODEL_PATH=best.pt

################################################# LLM 配置
# LLM_PROVIDER: "openai" (NVIDIA/DeepSeek/通义千问/LM Studio 等 OpenAI 兼容) | "ollama"
LLM_PROVIDER="openai"
LLM_API_BASE="http://localhost:1234/v1"
LLM_API_KEY="xxx"
LLM_MODEL_NAME="your-model-name"
LLM_IS_VISION_MODEL=True
LLM_ENABLE_THINKING=False
UPLOAD_DIR="static/uploads"

# Ollama 专有配置（仅当 LLM_PROVIDER="ollama" 时生效）
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_KEEP_ALIVE="1h"

################################################# RAG相关配置
RAG_SESSION_MEMORY_ENABLED=True
RAG_SESSION_WINDOW_TURNS=4

# RAG 并发与超时（云端 API + thinking 模式需要更长超时）
RAG_MAX_CONCURRENCY=2
RAG_OLLAMA_REQUEST_TIMEOUT_S=120.0
RAG_STREAM_TOTAL_TIMEOUT_S=300.0

# RAG 路由配置与置信度
RAG_ROUTE_MIN_CONTEXT_NODES=1
RAG_ROUTE_MIN_TOP_SCORE=-2.0

# ---- 切换提供商只需改上面 3 行，示例 ----
# DeepSeek:    LLM_API_BASE="https://api.deepseek.com/v1"  LLM_API_KEY="sk-xxx"  LLM_MODEL_NAME="deepseek-chat"
# 通义千问:    LLM_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"  LLM_API_KEY="sk-xxx"  LLM_MODEL_NAME="qwen-plus"
# LM Studio:   LLM_API_BASE="http://localhost:1234/v1"  LLM_API_KEY="lm-studio"  LLM_MODEL_NAME="qwen3.5-4b"
# NVIDIA NIM:  LLM_API_BASE="https://integrate.api.nvidia.com/v1"  LLM_API_KEY="nvapi-xxx"  LLM_MODEL_NAME="nvidia/llama-4-maverick-17b-128e-instruct"

# HuggingFace 模型缓存路径（必须在启动前设置）
HF_HOME='models/hf_cache'
HUGGINGFACE_HUB_CACHE='models/hf_cache'
LLAMA_INDEX_CACHE_DIR="models/hf_cache"  # 新增：LlamaIndex 缓存路径

# === 知识库配置 ===
KNOWLEDGE_DIR="knowledge_base"
MANAGED_VERSIONS_DIR=""   # 版本归档目录，_build_derived_paths 自动填充
ALLOWED_DOC_SUFFIXES=".pdf,.md,.markdown"  # 逗号分隔

# 默认分块参数（数据库有 KnowledgeChunkConfig 表可覆盖）
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHUNK_MIN_LEN=20

# 重建超时
KNOWLEDGE_BUILD_TIMEOUT_S=600

# Docling 模型缓存路径（PDF 解析模型，避免下载到系统默认目录）
DOCLING_CACHE_DIR="models/docling_cache"  # _build_derived_paths 自动填充

# === 安全配置 ===
INJECTION_BLOCK_THRESHOLD=6
INJECTION_SANITIZE_THRESHOLD=3
INJECTION_CONTEXT_THRESHOLD=3

# === Redis
# === Redis 配置 ===
REDIS_URL="xxx"
REDIS_MAX_CONNECTIONS=10


